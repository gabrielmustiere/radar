{% extends 'security.html.twig' %}

{% block title %}Connexion · Radar{% endblock %}

{% set field = 'block w-full rounded-xl border-0 bg-white px-4 py-3 text-sm text-gray-900 ring-1 ring-gray-200 placeholder:text-gray-400 focus:ring-2 focus:ring-gray-900 focus:outline-none dark:bg-gray-950 dark:text-white dark:ring-gray-800 dark:placeholder:text-gray-500 dark:focus:ring-gray-400' %}

{% block body %}
    <div class="flex min-h-screen items-center justify-center p-4 sm:p-8">
        <div class="grid w-full max-w-4xl overflow-hidden rounded-3xl bg-white shadow-xl shadow-gray-900/5 ring-1 ring-gray-200/70 md:grid-cols-2 dark:bg-gray-900 dark:shadow-none dark:ring-gray-800">

            {# Illustration #}
            <div class="flex flex-col border-b border-gray-200 bg-gray-50 p-8 md:border-r md:border-b-0 dark:border-gray-800 dark:bg-gray-950/40">
                {% include 'common/logo.html.twig' %}
                <p class="mt-3 text-sm text-gray-700 dark:text-gray-300">
                    Ce que l'équipe a repéré, <span class="font-semibold text-gray-900 dark:text-white">retrouvable des mois plus tard</span>.
                </p>
                <twig:ux:icon name="doodles:reading-side" class="mt-auto hidden h-auto w-full pt-8 text-gray-900 md:block dark:text-gray-200" aria-hidden="true"/>
            </div>

            {# Formulaire #}
            <div class="p-8 sm:p-10">
                <h1 class="font-display text-2xl font-bold tracking-tight text-gray-900 dark:text-white">Se connecter</h1>
                <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">
                    Identifiez-vous pour accéder à la veille de l'équipe.
                </p>

                <form method="post" class="mt-8 space-y-4">
                    {% if error %}
                        <div role="alert" class="flex items-start gap-3 rounded-xl border border-rose-200 bg-rose-50 p-3 dark:border-rose-900/50 dark:bg-rose-900/30">
                            <twig:ux:icon name="tabler:alert-circle" class="mt-0.5 size-5 shrink-0 text-rose-600 dark:text-rose-400"/>
                            <div class="text-sm text-rose-800 dark:text-rose-200">
                                {{ error.messageKey|trans(error.messageData, 'security') }}
                            </div>
                        </div>
                    {% endif %}

                    {% if app.user %}
                        <div class="flex items-start gap-3 rounded-xl border border-gray-200 bg-gray-50 p-3 dark:border-gray-700 dark:bg-gray-900">
                            <twig:ux:icon name="tabler:user-check" class="mt-0.5 size-5 shrink-0 text-gray-900 dark:text-white"/>
                            <div class="text-sm text-gray-900 dark:text-gray-200">
                                Connecté en tant que <span class="font-medium">{{ app.user.userIdentifier }}</span>.
                                <a href="{{ logout_path() }}" class="ml-1 font-medium underline hover:no-underline">Se déconnecter</a>
                            </div>
                        </div>
                    {% endif %}

                    <div>
                        <label for="username" class="mb-1.5 block text-sm font-medium text-gray-900 dark:text-gray-100">Email</label>
                        <input id="username" type="email" name="_username" value="{{ last_username }}"
                               required autocomplete="email" autofocus
                               placeholder="vous@exemple.com"
                               class="{{ field }}"/>
                    </div>

                    <div>
                        <label for="password" class="mb-1.5 block text-sm font-medium text-gray-900 dark:text-gray-100">Mot de passe</label>
                        <input id="password" type="password" name="_password" required
                               autocomplete="current-password"
                               placeholder="••••••••"
                               class="{{ field }}"/>
                    </div>

                    <input type="hidden" name="_csrf_token" data-controller="csrf-protection"
                           value="{{ csrf_token('authenticate') }}">

                    <div class="flex items-center justify-between">
                        <label class="inline-flex items-center gap-2 text-sm text-gray-700 dark:text-gray-300">
                            <input id="_remember_me" type="checkbox" name="_remember_me"
                                   class="size-4 rounded border-gray-300 text-gray-900 focus:ring-2 focus:ring-gray-300 dark:border-gray-700 dark:bg-gray-950 dark:focus:ring-gray-700"/>
                            Se souvenir de moi
                        </label>
                        <a href="#" class="text-sm font-medium text-gray-900 hover:text-gray-600 dark:text-white dark:hover:text-gray-300">Mot de passe oublié ?</a>
                    </div>

                    <button type="submit"
                            class="flex w-full items-center justify-center gap-2 rounded-xl bg-gray-900 px-4 py-3 text-sm font-medium text-white transition hover:bg-gray-700 focus:ring-4 focus:ring-gray-300 focus:outline-none dark:bg-white dark:text-gray-900 dark:hover:bg-gray-200 dark:focus:ring-gray-700">
                        Se connecter
                        <twig:ux:icon name="tabler:arrow-right" class="size-4"/>
                    </button>
                </form>

                <p class="mt-8 text-center text-xs text-gray-500">
                    Identifiants de test : <span class="font-mono text-gray-700 dark:text-gray-300">admin@example.com</span> / <span class="font-mono text-gray-700 dark:text-gray-300">password</span>
                </p>
            </div>
        </div>
    </div>
{% endblock %}
