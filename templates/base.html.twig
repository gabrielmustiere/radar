<!DOCTYPE html>
<html lang="fr" class="h-full">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    {# Turbo 8 : fondu du contenu entre deux pages (navigateurs compatibles, mouvement réduit respecté) #}
    <meta name="view-transition" content="same-origin">
    <title>{% block title %}Radar{% endblock %}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="icon"
          href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><rect width=%22128%22 height=%22128%22 rx=%2228%22 fill=%22%231c1917%22/><circle cx=%2264%22 cy=%2264%22 r=%2234%22 fill=%22none%22 stroke=%22%23ffffff%22 stroke-width=%2210%22/><circle cx=%2264%22 cy=%2264%22 r=%2210%22 fill=%22%23ffffff%22/></svg>">
    {% block stylesheets %}{% endblock %}

    {% block javascripts %}
        {% block importmap %}{{ importmap('app') }}{% endblock %}
    {% endblock %}
</head>
<body class="antialiased bg-gray-50 font-body text-gray-800 dark:bg-gray-950 dark:text-gray-200">

{# Topbar : sur téléphone, logo et avatar sur une ligne, recherche pleine largeur dessous #}
<nav class="sticky top-0 z-50 flex flex-wrap items-center justify-between gap-x-2 gap-y-3 border-b border-gray-200 bg-white px-4 py-3 sm:h-16 sm:flex-nowrap sm:gap-4 sm:py-0 md:px-6 dark:border-gray-800 dark:bg-gray-900">
    <div class="flex shrink-0 items-center">
        <a href="{{ path('app_page') }}">
            {% include 'common/logo.html.twig' with {compact: true} %}
        </a>
    </div>

    {# Sur une liste (fil, catégorie), la recherche la filtre au fil de la frappe ; ailleurs, elle mène au fil filtré #}
    {% set filters_list = app.current_route in ['app_page', 'app_category_show'] %}
    <form action="{{ path('app_page') }}" method="GET" role="search" class="order-last flex w-full min-w-0 justify-center sm:order-none sm:w-auto sm:flex-1"
          data-controller="search-shortcut{{ filters_list ? ' search-filter' }}"
          data-action="keydown@window->search-shortcut#focus{{ filters_list ? ' input->search-filter#filter submit->search-filter#filter:prevent' }}">
        <label for="topbar-search" class="sr-only">Rechercher</label>
        <div class="group relative w-full sm:max-w-lg">
            <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3">
                <twig:ux:icon name="tabler:search" class="size-4 text-gray-400"/>
            </div>
            <input type="search" name="q" id="topbar-search" value="{{ app.request.query.get('q') }}" data-test="topbar-search"
                   data-search-shortcut-target="input" aria-keyshortcuts="/" autocomplete="off"
                   class="block w-full rounded-xl border-0 bg-gray-50 py-2.5 pr-3 pl-9 text-[15px] text-gray-900 ring-1 ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-gray-900 focus:outline-none md:pr-10 dark:bg-gray-950 dark:text-white dark:ring-gray-700 dark:focus:ring-gray-400"
                   placeholder="Rechercher un lien…"/>
            <div class="pointer-events-none absolute inset-y-0 right-0 hidden items-center pr-2.5 group-focus-within:hidden md:flex">
                <twig:Kbd class="px-1.5 py-0.5">/</twig:Kbd>
            </div>
        </div>
    </form>

    <div class="flex shrink-0 items-center gap-2 sm:gap-3">
        {% if app.user %}
            <a href="{{ path('app_link_new') }}" data-test="add-link" data-turbo-frame="link-modal-frame"
               class="hidden items-center gap-2 rounded-xl bg-gray-900 px-4 py-2.5 text-sm font-semibold text-white hover:bg-gray-700 sm:flex dark:bg-white dark:text-gray-900 dark:hover:bg-gray-200">
                <twig:ux:icon name="tabler:plus" class="size-4"/> Ajouter un lien
            </a>
            <button type="button" data-dropdown-toggle="radar-topbar-user-menu" data-dropdown-placement="bottom-end" data-test="user-menu-toggle"
                    class="flex rounded-full focus:ring-4 focus:ring-gray-200 dark:focus:ring-gray-800">
                <span class="grid size-10 place-items-center rounded-full bg-white text-sm font-bold text-gray-900 ring-1 ring-gray-300 dark:bg-gray-900 dark:text-white dark:ring-gray-700">
                    {{ app.user.userIdentifier|first|upper }}
                </span>
            </button>
            {# Animation sur le contenu : Flowbite positionne le menu lui-même par transform #}
            <div class="z-50 my-4 hidden w-64 list-none" id="radar-topbar-user-menu">
              <div class="origin-top-right animate-radar-drop divide-y divide-gray-100 rounded-2xl bg-white text-base shadow-[0_20px_40px_-20px_rgb(23_24_28/0.35)] ring-1 ring-gray-200 dark:divide-gray-800 dark:bg-gray-900 dark:ring-gray-800">
                <div class="px-4 py-3">
                    <span class="block truncate text-sm font-semibold text-gray-900 dark:text-white">{{ app.user.userIdentifier }}</span>
                    <span class="block truncate text-xs text-gray-500 dark:text-gray-400" data-test="user-menu-profile">
                        {{- app.user.team ? app.user.team.label : 'Sans équipe' }}{{ is_granted('RADAR_ADMIN') ? ' · admin' -}}
                    </span>
                </div>
                <ul class="py-1 text-gray-700 dark:text-gray-300">
                    <li>
                        <a href="{{ path('app_extension_key') }}" data-test="extension-key-link" class="flex items-center gap-2 px-4 py-2 text-sm hover:bg-gray-50 dark:hover:bg-gray-800 dark:hover:text-white">
                            <twig:ux:icon name="tabler:puzzle" class="size-4"/> Extension navigateur
                        </a>
                    </li>
                </ul>
                {% if is_granted('RADAR_ADMIN') %}
                    {% set admin_item = 'flex items-center gap-2 px-4 py-2 text-sm hover:bg-gray-50 dark:hover:bg-gray-800 dark:hover:text-white' %}
                    {% set admin_active = ' font-semibold text-gray-900 dark:text-white' %}
                    <div class="py-1 text-gray-700 dark:text-gray-300" data-test="user-menu-admin">
                        <p class="px-4 pt-2 pb-1 text-xs font-semibold tracking-wide text-gray-500 uppercase dark:text-gray-400">Administration</p>
                        <ul>
                            <li>
                                <a href="{{ path('app_source_index') }}" data-test="nav-sources" class="{{ admin_item }}{{ app.current_route == 'app_source_index' ? admin_active }}">
                                    <twig:ux:icon name="tabler:rss" class="size-4"/> Sources
                                </a>
                            </li>
                            <li>
                                <a href="{{ path('app_admin_user_index') }}" data-test="nav-users" class="{{ admin_item }}{{ app.current_route starts with 'app_admin_user' ? admin_active }}">
                                    <twig:ux:icon name="tabler:users" class="size-4"/> Comptes
                                </a>
                            </li>
                            <li>
                                <a href="{{ path('app_admin_category_index') }}" data-test="nav-categories" class="{{ admin_item }}{{ app.current_route == 'app_admin_category_index' ? admin_active }}">
                                    <twig:ux:icon name="tabler:tags" class="size-4"/> Catégories
                                </a>
                            </li>
                        </ul>
                    </div>
                {% endif %}
                <ul class="py-1">
                    <li>
                        {# Turbo 8 précharge les liens au survol : jamais celui-ci, un GET /logout déconnecte #}
                        <a href="{{ path('app_logout') }}" data-test="logout-link" data-turbo-prefetch="false"
                           class="flex items-center gap-2 px-4 py-2 text-sm text-rose-700 hover:bg-rose-50 dark:text-rose-300 dark:hover:bg-rose-900/30">
                            <twig:ux:icon name="tabler:logout" class="size-4"/> Déconnexion
                        </a>
                    </li>
                </ul>
              </div>
            </div>
        {% else %}
            <a href="{{ path('app_login') }}"
               class="flex items-center gap-2 rounded-xl bg-gray-900 px-4 py-2.5 text-sm font-medium text-white hover:bg-gray-700 dark:bg-white dark:text-gray-900 dark:hover:bg-gray-200">
                <twig:ux:icon name="tabler:login" class="size-4"/> Se connecter
            </a>
        {% endif %}
    </div>
</nav>

<main class="[view-transition-name:main]">
    <div class="min-h-[calc(100vh-4rem)] px-4 pt-5 pb-24 sm:px-6 sm:pb-12 md:px-8">
        {% block body %}{% endblock %}
    </div>
</main>

{% if app.user %}
    {# Sur téléphone, le bouton flottant remplace « Ajouter un lien » de la topbar #}
    <a href="{{ path('app_link_new') }}" data-test="add-link-fab" data-turbo-frame="link-modal-frame"
       class="fixed right-4 bottom-4 z-40 grid size-15 place-items-center rounded-full bg-gray-900 text-white shadow-[0_12px_28px_-10px_rgb(23_24_28/0.6)] transition active:scale-95 sm:hidden dark:bg-white dark:text-gray-900">
        <twig:ux:icon name="tabler:plus" class="size-7"/>
        <span class="sr-only">Ajouter un lien</span>
    </a>
{% endif %}

{# Modale d'ajout : « Ajouter un lien » y charge le formulaire (Turbo Frame), la page dédiée reste le repli. #}
{% if app.user and app.current_route not in ['app_link_new', 'app_link_seed'] %}
    <dialog data-controller="link-modal" data-test="link-modal" aria-label="Ajouter un lien"
            data-action="turbo:before-fetch-request->link-modal#open close->link-modal#reset click->link-modal#closeOnBackdrop turbo:before-cache@document->link-modal#close"
            class="m-auto w-[calc(100%-2rem)] max-w-2xl rounded-3xl bg-white p-6 text-gray-800 opacity-0 shadow-2xl ring-1 ring-gray-200/70 transition duration-[280ms] ease-radar-spring transition-discrete backdrop:bg-gray-950/40 backdrop:backdrop-blur-xs open:opacity-100 starting:open:translate-y-2.5 starting:open:scale-97 starting:open:opacity-0 motion-reduce:transition-none sm:p-8 dark:bg-gray-900 dark:text-gray-200 dark:ring-gray-800">
        <button type="button" data-action="link-modal#close" data-test="link-modal-close"
                class="absolute top-4 right-4 grid size-8 place-items-center rounded-lg text-gray-400 hover:bg-gray-100 hover:text-gray-700 dark:hover:bg-gray-800 dark:hover:text-white">
            <twig:ux:icon name="tabler:x" class="size-5"/>
            <span class="sr-only">Fermer</span>
        </button>
        {# Frame instanciée par le contrôleur : absente du HTML servi, la redirection qui suit l'ajout
           ne la retrouve pas et s'affiche en page complète (turbo:frame-missing, cf. app.js) #}
        <template data-link-modal-target="template">
            <turbo-frame id="link-modal-frame" data-link-modal-target="frame">
                <div class="flex justify-center py-24">
                    <twig:ux:icon name="tabler:loader-2" class="size-6 animate-spin text-gray-900 dark:text-white"/>
                </div>
            </turbo-frame>
        </template>
    </dialog>
{% endif %}

{% include 'common/flash-messages.html.twig' %}

</body>
</html>
