<!DOCTYPE html>
<html lang="fr" class="h-full">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    {# Turbo 8 : fondu du contenu entre deux pages (navigateurs compatibles, mouvement réduit respecté) #}
    <meta name="view-transition" content="same-origin">
    <title>{% block title %}Radar{% endblock %}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="icon"
          href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><rect width=%22128%22 height=%22128%22 rx=%2228%22 fill=%22%231c1917%22/><circle cx=%2264%22 cy=%2264%22 r=%2234%22 fill=%22none%22 stroke=%22%232dd4bf%22 stroke-width=%2210%22/><circle cx=%2264%22 cy=%2264%22 r=%2210%22 fill=%22%232dd4bf%22/></svg>">
    {% block stylesheets %}{% endblock %}

    {% block javascripts %}
        {% block importmap %}{{ importmap('app') }}{% endblock %}
    {% endblock %}
</head>
<body class="antialiased bg-gray-50 font-body text-gray-800 dark:bg-gray-950 dark:text-gray-200">

{# Topbar #}
<nav class="fixed inset-x-0 top-0 z-50 flex h-16 items-center justify-between gap-4 bg-gray-50 px-4 dark:bg-gray-950 md:px-6">
    <div class="flex items-center md:w-58">
        <button data-drawer-target="radar-sidebar" data-drawer-toggle="radar-sidebar"
                aria-controls="radar-sidebar" type="button"
                class="mr-2 rounded-lg p-2 text-gray-600 hover:bg-white hover:text-gray-900 md:hidden dark:text-gray-400 dark:hover:bg-gray-900 dark:hover:text-white">
            <twig:ux:icon name="tabler:menu-2" class="size-6"/>
            <span class="sr-only">Ouvrir le menu</span>
        </button>
        <a href="{{ path('app_page') }}">
            {% include 'common/logo.html.twig' %}
        </a>
    </div>

    <form action="{{ path('app_search') }}" method="GET" role="search" class="hidden flex-1 justify-center md:flex"
          data-controller="search-shortcut" data-action="keydown@window->search-shortcut#focus">
        <label for="topbar-search" class="sr-only">Rechercher</label>
        <div class="group relative w-full max-w-sm">
            <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3">
                <twig:ux:icon name="tabler:search" class="size-4 text-gray-400"/>
            </div>
            <input type="search" name="q" id="topbar-search" value="{{ app.request.query.get('q') }}" data-test="topbar-search"
                   data-search-shortcut-target="input" aria-keyshortcuts="/"
                   class="block w-full rounded-xl border-0 bg-white py-2.5 pr-10 pl-9 text-sm text-gray-900 shadow-xs ring-1 ring-gray-200/70 placeholder:text-gray-400 focus:ring-2 focus:ring-teal-500 focus:outline-none dark:bg-gray-900 dark:text-white dark:ring-gray-800"
                   placeholder="Rechercher un lien…"/>
            <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center pr-2.5 group-focus-within:hidden">
                <twig:Kbd class="px-1.5 py-0.5">/</twig:Kbd>
            </div>
        </div>
    </form>

    <div class="flex items-center gap-3">
        {% if app.user %}
            <a href="{{ path('app_link_new') }}" data-test="add-link" data-turbo-frame="link-modal-frame"
               class="flex items-center gap-2 rounded-xl bg-teal-600 px-3 py-2.5 text-sm font-medium text-white hover:bg-teal-700 sm:px-4">
                <twig:ux:icon name="tabler:plus" class="size-4"/> <span class="hidden sm:inline">Ajouter un lien</span>
            </a>
            <button type="button" data-dropdown-toggle="radar-topbar-user-menu" data-test="user-menu-toggle"
                    class="flex rounded-full focus:ring-4 focus:ring-teal-100 dark:focus:ring-teal-900">
                <span class="grid size-9 place-items-center rounded-full bg-white text-sm font-semibold text-teal-700 shadow-xs ring-1 ring-gray-200 dark:bg-gray-900 dark:text-teal-400 dark:ring-gray-800">
                    {{ app.user.userIdentifier|first|upper }}
                </span>
            </button>
            <div class="z-50 my-4 hidden w-56 list-none divide-y divide-gray-100 rounded-2xl bg-white text-base shadow-lg ring-1 ring-gray-200/70 dark:divide-gray-800 dark:bg-gray-900 dark:ring-gray-800"
                 id="radar-topbar-user-menu">
                <div class="px-4 py-3">
                    <span class="block text-sm font-semibold text-gray-900 dark:text-white">{{ app.user.userIdentifier }}</span>
                    <span class="block truncate text-xs text-gray-500 dark:text-gray-400">Compte utilisateur</span>
                </div>
                <ul class="py-1 text-gray-700 dark:text-gray-300">
                    <li>
                        <a href="#" class="flex items-center gap-2 px-4 py-2 text-sm hover:bg-gray-50 dark:hover:bg-gray-800 dark:hover:text-white">
                            <twig:ux:icon name="tabler:user" class="size-4"/> Mon profil
                        </a>
                    </li>
                    <li>
                        <a href="#" class="flex items-center gap-2 px-4 py-2 text-sm hover:bg-gray-50 dark:hover:bg-gray-800 dark:hover:text-white">
                            <twig:ux:icon name="tabler:settings" class="size-4"/> Paramètres
                        </a>
                    </li>
                </ul>
                <ul class="py-1">
                    <li>
                        {# Turbo 8 précharge les liens au survol : jamais celui-ci, un GET /logout déconnecte #}
                        <a href="{{ path('app_logout') }}" data-test="logout-link" data-turbo-prefetch="false"
                           class="flex items-center gap-2 px-4 py-2 text-sm text-rose-700 hover:bg-rose-50 dark:text-rose-300 dark:hover:bg-rose-900/30">
                            <twig:ux:icon name="tabler:logout" class="size-4"/> Déconnexion
                        </a>
                    </li>
                </ul>
            </div>
        {% else %}
            <a href="{{ path('app_login') }}"
               class="flex items-center gap-2 rounded-xl bg-teal-600 px-4 py-2.5 text-sm font-medium text-white hover:bg-teal-700">
                <twig:ux:icon name="tabler:login" class="size-4"/> Se connecter
            </a>
        {% endif %}
    </div>
</nav>

{# Sidebar #}
{% set nav_item = 'flex items-center gap-3 rounded-xl px-3 py-2.5 text-sm font-medium transition' %}
{% set nav_idle = nav_item ~ ' text-gray-700 hover:bg-white hover:text-gray-900 dark:text-gray-300 dark:hover:bg-gray-900 dark:hover:text-white' %}
{% set nav_active = nav_item ~ ' bg-white font-semibold text-teal-700 shadow-xs ring-1 ring-gray-200/70 dark:bg-gray-900 dark:text-teal-400 dark:ring-gray-800' %}
<aside id="radar-sidebar"
       class="fixed top-0 left-0 z-40 h-screen w-64 -translate-x-full bg-gray-50 pt-16 transition-transform md:translate-x-0 dark:bg-gray-950"
       aria-label="Sidebar">
    <div class="h-full overflow-y-auto px-4 py-4">
        <ul class="space-y-1">
            <li>
                <a href="{{ path('app_page') }}" class="{{ app.current_route == 'app_page' ? nav_active : nav_idle }}">
                    <twig:ux:icon name="tabler:bookmarks" class="size-5"/>
                    <span>Tous les liens</span>
                </a>
            </li>
        </ul>
        <twig:CategoryNav :currentId="category.id ?? null"/>
        <ul class="mt-4 space-y-1 border-t border-gray-200 pt-4 dark:border-gray-800">
            <li>
                <a href="{{ path('app_design_system') }}" class="{{ app.current_route == 'app_design_system' ? nav_active : nav_idle }}">
                    <twig:ux:icon name="tabler:palette" class="size-5"/>
                    <span>Design System</span>
                </a>
            </li>
            {# La route app_test_email n'existe qu'en dev (env: 'dev') #}
            {% if app.environment == 'dev' %}
            <li>
                <a href="{{ path('app_test_email') }}" class="{{ nav_idle }}">
                    <twig:ux:icon name="tabler:mail" class="size-5"/>
                    <span>Tester l'email</span>
                </a>
            </li>
            {% endif %}
        </ul>
    </div>
</aside>

<main class="pt-16 [view-transition-name:main] md:ml-64">
    <div class="min-h-[calc(100vh-4rem)] bg-white p-4 sm:p-6 md:rounded-tl-4xl md:p-10 dark:bg-gray-900">
        {% block body %}{% endblock %}
    </div>
</main>

{# Modale d'ajout : « Ajouter un lien » y charge le formulaire (Turbo Frame), la page dédiée reste le repli. #}
{% if app.user and app.current_route not in ['app_link_new', 'app_link_seed'] %}
    <dialog data-controller="link-modal" data-test="link-modal" aria-label="Ajouter un lien"
            data-action="turbo:before-fetch-request->link-modal#open close->link-modal#reset click->link-modal#closeOnBackdrop turbo:before-cache@document->link-modal#close"
            class="m-auto w-[calc(100%-2rem)] max-w-2xl rounded-3xl bg-white p-6 text-gray-800 opacity-0 shadow-2xl ring-1 ring-gray-200/70 transition duration-200 transition-discrete backdrop:bg-gray-950/40 backdrop:backdrop-blur-xs open:opacity-100 starting:open:translate-y-2 starting:open:opacity-0 sm:p-8 dark:bg-gray-900 dark:text-gray-200 dark:ring-gray-800">
        <button type="button" data-action="link-modal#close" data-test="link-modal-close"
                class="absolute top-4 right-4 grid size-8 place-items-center rounded-lg text-gray-400 hover:bg-gray-100 hover:text-gray-700 dark:hover:bg-gray-800 dark:hover:text-white">
            <twig:ux:icon name="tabler:x" class="size-5"/>
            <span class="sr-only">Fermer</span>
        </button>
        {# Frame instanciée par le contrôleur : absente du HTML servi, la redirection qui suit l'ajout
           ne la retrouve pas et s'affiche en page complète (turbo:frame-missing, cf. app.js) #}
        <template data-link-modal-target="template">
            <turbo-frame id="link-modal-frame" data-link-modal-target="frame">
                <div class="flex justify-center py-24">
                    <twig:ux:icon name="tabler:loader-2" class="size-6 animate-spin text-teal-600"/>
                </div>
            </turbo-frame>
        </template>
    </dialog>
{% endif %}

{% include 'common/flash-messages.html.twig' %}

</body>
</html>
