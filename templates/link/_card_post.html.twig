{# Post X mis en avant à la place d'un visuel, que X ne fournit pas : auteur, compte et texte du post #}
{% set handle = link.url|x_handle %}
<div class="border-b border-sky-100 bg-sky-50 px-5 pt-12 pb-5 dark:border-sky-500/20 dark:bg-sky-500/10" data-test="link-post">
    <div class="flex items-center gap-3">
        <span class="grid size-10 shrink-0 place-items-center rounded-full bg-gray-900 font-display text-base font-semibold text-white uppercase dark:bg-white dark:text-gray-900" aria-hidden="true">
            {{- (link.author ?? handle ?? 'x')|first -}}
        </span>
        <p class="min-w-0 flex-1 leading-tight">
            {% if link.author %}
                <span class="block truncate text-sm font-semibold text-sky-950 dark:text-white" data-test="link-author">{{ link.author }}</span>
            {% endif %}
            {% if handle %}
                <span class="block truncate text-xs text-gray-500 dark:text-gray-400" data-test="link-handle">@{{ handle }}</span>
            {% endif %}
        </p>
        <twig:ux:icon name="tabler:brand-x" class="size-5 shrink-0 text-gray-900 dark:text-white" aria-hidden="true"/>
    </div>
    {% if link.description %}
        <p class="mt-4 line-clamp-6 text-[0.95rem] leading-relaxed text-gray-800 dark:text-gray-200" data-test="link-description">{{ link.description }}</p>
    {% endif %}
</div>
