{% extends 'base.html.twig' %}

{% block title %}Reprendre un lien de Chat · Radar{% endblock %}

{% block body %}
    {# Ouverte directement ou chargée dans la modale d'ajout (même frame) #}
    <twig:Turbo:Frame id="link-modal-frame" class="mx-auto block max-w-2xl">
        <h1 class="font-display text-2xl font-bold tracking-tight text-gray-900 dark:text-white">Reprendre un lien de Chat</h1>
        <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">
            Pour amorcer Radar avec les meilleurs liens déjà postés : ils gardent leur date et leur posteur d'origine, et ne sont pas réannoncés.
        </p>

        <twig:LinkForm :form="form" :historical="true"/>
    </twig:Turbo:Frame>
{% endblock %}
