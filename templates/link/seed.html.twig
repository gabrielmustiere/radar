{% extends 'base.html.twig' %}

{% block title %}Reprendre un lien de Chat · Radar{% endblock %}

{% block body %}
    <div class="mx-auto max-w-2xl">
        <h1 class="font-display text-2xl font-bold tracking-tight text-gray-900 dark:text-white">Reprendre un lien de Chat</h1>
        <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">
            Pour amorcer Radar avec les meilleurs liens déjà postés : ils gardent leur date et leur posteur d'origine, et ne sont pas réannoncés.
        </p>

        {% if duplicate %}
            {% include 'link/_duplicate.html.twig' %}
        {% endif %}

        {{ form_start(form, {attr: {class: 'mt-8 space-y-6', 'data-test': 'link-form', novalidate: 'novalidate'}}) }}
            {% include 'link/_fields.html.twig' %}

            <div class="grid gap-4 sm:grid-cols-2">
                {{ form_row(form.postedAt) }}
                {{ form_row(form.poster) }}
            </div>

            <div class="flex items-center gap-3">
                <button type="submit" data-test="link-submit"
                        class="inline-flex items-center gap-2 rounded-xl bg-teal-600 px-5 py-2.5 text-sm font-medium text-white hover:bg-teal-700 focus:ring-4 focus:ring-teal-200 focus:outline-none dark:focus:ring-teal-900">
                    <twig:ux:icon name="tabler:history" class="size-4"/> Reprendre
                </button>
                <a href="{{ path('app_link_new') }}" class="text-sm font-medium text-gray-600 hover:text-gray-900 dark:text-gray-400 dark:hover:text-white">Annuler</a>
            </div>
        {{ form_end(form) }}
    </div>
{% endblock %}
