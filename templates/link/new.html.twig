{% extends 'base.html.twig' %}

{% block title %}Ajouter un lien · Radar{% endblock %}

{% block body %}
    {# Ouverte directement ou chargée dans la modale d'ajout (même frame) #}
    <twig:Turbo:Frame id="link-modal-frame" class="mx-auto block max-w-2xl">
        <h1 class="font-display text-2xl font-bold tracking-tight text-gray-900 dark:text-white">Ajouter un lien</h1>
        <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">
            Collez l'adresse, choisissez une ou deux catégories-besoins : c'est tout.
        </p>

        <twig:LinkForm :form="form"/>
    </twig:Turbo:Frame>
{% endblock %}
