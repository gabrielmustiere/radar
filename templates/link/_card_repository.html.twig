{# Visuel d'un dépôt GitHub reconstruit depuis ses métadonnées, plutôt que l'image générique de GitHub #}
{% set owner = repository|split('/')|first %}
{% set name = repository|split('/')|last %}
<div class="relative flex aspect-[1.91/1] flex-col justify-between overflow-hidden bg-violet-50 p-5 text-violet-950 dark:bg-violet-500/10 dark:text-white"
     data-test="link-repository">
    <twig:ux:icon name="tabler:brand-github" class="absolute -right-8 -bottom-10 size-44 text-violet-600/5 dark:text-white/5" aria-hidden="true"/>
    {# Place du badge de type, posé par la carte #}
    <span class="h-4"></span>
    <p class="min-w-0">
        <span class="block truncate font-mono text-sm text-violet-700 dark:text-violet-300" data-test="link-repository-owner">{{ owner }} /</span>
        <span class="mt-0.5 line-clamp-2 font-display text-2xl leading-tight font-bold break-words" data-test="link-repository-name">{{ name }}</span>
    </p>
    <p class="flex min-h-5 flex-wrap items-center gap-x-4 gap-y-1 text-sm text-violet-950/80 dark:text-white/80">
        {% if link.githubStars is not null %}
            <span class="inline-flex items-center gap-1" title="Étoiles sur GitHub" data-test="link-stars">
                <twig:ux:icon name="tabler:star-filled" class="size-4 text-amber-500 dark:text-amber-300" aria-hidden="true"/> {{ link.githubStars|number_format(0, ',', ' ') }}
            </span>
        {% endif %}
        {% if link.githubLanguage %}
            <span class="inline-flex items-center gap-1.5" title="Langage principal" data-test="link-language">
                <span class="size-2.5 rounded-full bg-violet-500 dark:bg-violet-400"></span> {{ link.githubLanguage }}
            </span>
        {% endif %}
    </p>
</div>
