{% set fallback_styles = {
    github: 'bg-gradient-to-br from-gray-800 to-gray-950 text-white',
    youtube: 'bg-gradient-to-br from-rose-50 to-rose-100 text-rose-600 dark:from-rose-500/10 dark:to-rose-500/20 dark:text-rose-300',
    x: 'bg-gradient-to-br from-gray-100 to-gray-200 text-gray-900 dark:from-gray-800 dark:to-gray-900 dark:text-white',
    image: 'bg-gradient-to-br from-amber-50 to-amber-100 text-amber-600 dark:from-amber-500/10 dark:to-amber-500/20 dark:text-amber-300',
    article: 'bg-gradient-to-br from-teal-50 to-teal-100 text-teal-600 dark:from-teal-500/10 dark:to-teal-500/20 dark:text-teal-300',
} %}
{% set source = link.sourceType %}
{% set host = link.url|link_host %}
<article class="flex flex-col overflow-hidden rounded-2xl bg-white ring-1 ring-gray-200/70 transition hover:shadow-md hover:shadow-gray-900/5 dark:bg-gray-950 dark:ring-gray-800"
         data-test="link-card" data-preview-status="{{ link.previewStatus.value }}">
    <div class="relative aspect-[1.91/1] overflow-hidden" {% if link.imageUrl %}data-controller="image-fallback"{% endif %}>
        <div class="absolute inset-0 flex flex-col items-center justify-center gap-2 {{ fallback_styles[source.value] }}"
             data-test="link-card-fallback" {% if link.imageUrl %}data-image-fallback-target="fallback" hidden{% endif %}>
            <twig:ux:icon name="{{ source.icon }}" class="size-10 opacity-90"/>
            <span class="max-w-[80%] truncate text-sm font-medium opacity-80">{{ host }}</span>
        </div>
        {% if link.imageUrl %}
            <img src="{{ link.imageUrl }}" alt="" loading="lazy" referrerpolicy="no-referrer"
                 class="absolute inset-0 size-full object-cover" data-test="link-card-image"
                 data-image-fallback-target="image" data-action="error->image-fallback#fallback">
        {% endif %}
    </div>

    <div class="flex flex-1 flex-col p-4">
        <p class="flex items-center gap-1.5 text-xs font-medium text-gray-500 dark:text-gray-400" data-test="link-source">
            <twig:ux:icon name="{{ source.icon }}" class="size-4"/>
            <span>{{ source.label }}</span>
            <span class="size-1 rounded-full bg-gray-300 dark:bg-gray-700"></span>
            <span class="truncate">{{ link.siteName ?? host }}</span>
        </p>

        <h2 class="mt-2 line-clamp-2 font-display text-base font-semibold leading-snug text-gray-900 dark:text-white" data-test="link-title">
            {{ link.title ?? link.url }}
        </h2>

        {% if link.description %}
            <p class="mt-1.5 line-clamp-2 text-sm text-gray-600 dark:text-gray-400" data-test="link-description">{{ link.description }}</p>
        {% endif %}

        {% if link.context %}
            <p class="mt-3 border-l-2 border-teal-500 pl-3 text-sm text-gray-700 italic dark:text-gray-300" data-test="link-context">{{ link.context }}</p>
        {% endif %}

        <div class="mt-auto flex flex-wrap gap-1.5 pt-4">
            {% for category in link.categories %}
                <span class="rounded-full bg-teal-50 px-2 py-0.5 text-xs font-medium text-teal-800 dark:bg-teal-500/10 dark:text-teal-300" data-test="link-category">{{ category.name }}</span>
            {% endfor %}
        </div>

        <div class="mt-3 flex items-center gap-2 border-t border-gray-100 pt-3 text-xs text-gray-500 dark:border-gray-800 dark:text-gray-400">
            <span class="grid size-6 place-items-center rounded-full bg-gray-100 text-[0.65rem] font-semibold text-teal-700 uppercase dark:bg-gray-800 dark:text-teal-400">{{ link.postedBy.displayName|first }}</span>
            <span data-test="link-poster">{{ link.postedBy.displayName }}</span>
            <span class="size-1 rounded-full bg-gray-300 dark:bg-gray-700"></span>
            <time datetime="{{ link.postedAt|date('c') }}" data-test="link-date">{{ link.postedAt|date('d/m/Y') }}</time>
            {% if link.seeded %}
                <span class="ml-auto inline-flex items-center gap-1" title="Repris de l'historique Google Chat" data-test="link-seeded">
                    <twig:ux:icon name="tabler:history" class="size-3.5"/> repris de Chat
                </span>
            {% endif %}
        </div>
    </div>
</article>
