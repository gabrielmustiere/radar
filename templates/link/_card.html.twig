{% set source = link.sourceType %}
{% set host = link.url|link_host %}
{% set video_id = source.value == 'youtube' ? link.url|youtube_id : null %}
{% set repository = source.value == 'github' ? link.url|github_repository : null %}
{% set post = source.value == 'x' %}
<article id="link-card-{{ link.id }}" class="flex flex-col overflow-hidden rounded-2xl bg-white ring-1 ring-gray-200/70 transition hover:shadow-md hover:shadow-gray-900/5 dark:bg-gray-950 dark:ring-gray-800"
         data-test="link-card" data-preview-status="{{ link.previewStatus.value }}">
    {% if video_id %}
        {# Façade : rien de YouTube ne se charge avant le clic, et la lecture compte comme une ouverture du lien #}
        <div class="relative aspect-[1.91/1] overflow-hidden" data-test="link-video"
             data-controller="video-facade{{ link.imagePath ? ' image-fallback' }}"
             data-video-facade-video-id-value="{{ video_id }}"
             data-video-facade-play-url-value="{{ path('app_link_play', {id: link.id}) }}"
             data-video-facade-token-value="{{ csrf_token('link-play') }}"
             data-video-facade-title-value="{{ link.title ?? link.url }}">
            {% include 'link/_card_visual.html.twig' %}
            <button type="button" data-action="video-facade#play" data-test="link-video-play"
                    aria-label="Lire la vidéo « {{ link.title ?? host }} »"
                    class="group absolute inset-0 grid cursor-pointer place-items-center">
                <span class="grid size-14 place-items-center rounded-full bg-gray-950/75 text-white shadow-lg transition group-hover:scale-105 group-hover:bg-rose-600">
                    <twig:ux:icon name="tabler:player-play-filled" class="size-7"/>
                </span>
            </button>
        </div>
    {% elseif repository %}
        {% include 'link/_card_repository.html.twig' %}
    {% elseif post %}
        {% include 'link/_card_post.html.twig' %}
    {% else %}
        <a href="{{ path('app_link_open', {id: link.id}) }}" target="_blank" rel="noopener noreferrer" tabindex="-1" aria-hidden="true"
           class="relative block aspect-[1.91/1] overflow-hidden" {% if link.imagePath %}data-controller="image-fallback"{% endif %}>
            {% include 'link/_card_visual.html.twig' %}
        </a>
    {% endif %}

    <div class="flex flex-1 flex-col p-4">
        <p class="flex items-center gap-1.5 text-xs font-medium text-gray-500 dark:text-gray-400" data-test="link-source">
            <twig:ux:icon name="{{ source.icon }}" class="size-4"/>
            <span>{{ source.label }}</span>
            <span class="size-1 rounded-full bg-gray-300 dark:bg-gray-700"></span>
            <span class="truncate">{{ link.siteName ?? host }}</span>
        </p>

        <h2 class="mt-2 line-clamp-2 font-display text-base font-semibold leading-snug text-gray-900 dark:text-white" data-test="link-title">
            <a href="{{ path('app_link_open', {id: link.id}) }}" target="_blank" rel="noopener noreferrer" class="hover:text-teal-700 dark:hover:text-teal-400">{{ link.title ?? link.url }}</a>
        </h2>

        {# L'auteur et le texte d'un post X sont déjà dans son visuel #}
        {% if not post and (link.author or link.publishedAt) %}
            <p class="mt-1.5 text-xs text-gray-500 dark:text-gray-400" data-test="link-byline">
                {%- if link.author -%}
                    Par <span class="font-medium text-gray-700 dark:text-gray-300" data-test="link-author">{{ link.author }}</span>
                {%- endif -%}
                {%- if link.publishedAt -%}
                    {{ link.author ? ' · publié le ' : 'Publié le ' }}<time datetime="{{ link.publishedAt|date('c') }}" data-test="link-published-at">{{ link.publishedAt|date('d/m/Y', 'Europe/Paris') }}</time>
                {%- endif -%}
            </p>
        {% endif %}

        {% if link.description and not post %}
            <p class="mt-1.5 line-clamp-2 text-sm text-gray-600 dark:text-gray-400" data-test="link-description">{{ link.description }}</p>
        {% endif %}

        {% if link.context %}
            <p class="mt-3 border-l-2 border-teal-500 pl-3 text-sm text-gray-700 italic dark:text-gray-300" data-test="link-context">{{ link.context }}</p>
        {% endif %}

        <div class="mt-auto flex flex-wrap gap-1.5 pt-4">
            {% for category in link.categories %}
                <a href="{{ path('app_category_show', {id: category.id}) }}" class="rounded-full bg-teal-50 px-2 py-0.5 text-xs font-medium text-teal-800 hover:bg-teal-100 dark:bg-teal-500/10 dark:text-teal-300 dark:hover:bg-teal-500/20" data-test="link-category">{{ category.name }}</a>
            {% endfor %}
        </div>

        <div class="mt-3 flex items-center gap-2 border-t border-gray-100 pt-3 text-xs text-gray-500 dark:border-gray-800 dark:text-gray-400">
            <span class="grid size-6 place-items-center rounded-full bg-gray-100 text-[0.65rem] font-semibold text-teal-700 uppercase dark:bg-gray-800 dark:text-teal-400">{{ link.postedBy.displayName|first }}</span>
            <span data-test="link-poster">{{ link.postedBy.displayName }}</span>
            <span class="size-1 rounded-full bg-gray-300 dark:bg-gray-700"></span>
            <time datetime="{{ link.postedAt|date('c') }}" data-test="link-date">{{ link.postedAt|date('d/m/Y') }}</time>
            {% if link.seeded %}
                <span class="inline-flex items-center gap-1" title="Repris de l'historique Google Chat" data-test="link-seeded">
                    <twig:ux:icon name="tabler:history" class="size-3.5"/> repris de Chat
                </span>
            {% endif %}
            <a href="{{ path('app_link_open', {id: link.id}) }}" target="_blank" rel="noopener noreferrer" data-test="link-open" title="Ouvrir {{ link.url }}"
               class="ml-auto inline-flex items-center gap-1 rounded-lg px-2 py-1 font-medium text-teal-700 hover:bg-teal-50 dark:text-teal-400 dark:hover:bg-teal-500/10">
                Ouvrir <twig:ux:icon name="tabler:external-link" class="size-3.5"/>
            </a>
        </div>
    </div>
</article>
