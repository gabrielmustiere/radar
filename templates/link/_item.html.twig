<li class="rounded-2xl bg-white p-4 ring-1 ring-gray-200/70 dark:bg-gray-950 dark:ring-gray-800" data-test="link-item">
    <a href="{{ link.url }}" target="_blank" rel="noopener noreferrer"
       class="block truncate text-sm font-semibold text-gray-900 hover:text-teal-700 dark:text-white dark:hover:text-teal-400">{{ link.url }}</a>
    {% if link.context %}
        <p class="mt-1 text-sm text-gray-700 dark:text-gray-300" data-test="link-context">{{ link.context }}</p>
    {% endif %}
    <div class="mt-3 flex flex-wrap items-center gap-x-3 gap-y-2 text-xs text-gray-500 dark:text-gray-400">
        <span data-test="link-poster">{{ link.postedBy.displayName }}</span>
        <span class="size-1 rounded-full bg-gray-300 dark:bg-gray-700"></span>
        <time datetime="{{ link.postedAt|date('c') }}">{{ link.postedAt|date('d/m/Y') }}</time>
        {% for category in link.categories %}
            <span class="rounded-full bg-teal-50 px-2 py-0.5 font-medium text-teal-800 dark:bg-teal-500/10 dark:text-teal-300" data-test="link-category">{{ category.name }}</span>
        {% endfor %}
    </div>
</li>
