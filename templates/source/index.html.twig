{% extends 'base.html.twig' %}

{% block title %}Sources · Radar{% endblock %}

{% block body %}
    <div class="mx-auto flex max-w-3xl flex-col gap-6">
        {% include 'admin/_tabs.html.twig' %}

        <div class="flex flex-col gap-2">
            <h1 class="flex items-center gap-3 font-display text-3xl font-bold tracking-tight text-gray-900 dark:text-white">
                <span class="grid size-9 shrink-0 place-items-center rounded-[10px] bg-orange-700 text-white dark:bg-orange-600">
                    <twig:ux:icon name="tabler:rss" class="size-5"/>
                </span>
                Sources
            </h1>
            <p class="max-w-[680px] text-[15px] leading-relaxed text-gray-500 dark:text-gray-400">
                Chaque nouvel article d'une source est publié automatiquement, dans ses catégories, et annoncé dans Google Chat.
                Les articles déjà présents dans le flux au moment de l'ajout sont ignorés : « Relever » permet d'aller chercher
                ceux parus sur les dernières heures.
            </p>
        </div>

        <twig:SourceForm :form="form"/>

        <section class="flex flex-col gap-2.5">
            <h2 class="text-base font-bold text-gray-900 dark:text-white">Sources suivies</h2>
            <ul class="divide-y divide-gray-100 overflow-hidden rounded-[20px] bg-white ring-1 ring-gray-200/70 dark:divide-gray-800 dark:bg-gray-900 dark:ring-gray-800" data-test="source-list">
                {% for source in sources %}
                    <li class="grid grid-cols-[2.75rem_minmax(0,1fr)] items-start gap-x-3.5 gap-y-3 px-4.5 py-4 text-sm transition-colors hover:bg-gray-50/70 sm:grid-cols-[2.75rem_minmax(0,1fr)_auto] dark:hover:bg-white/[0.03]" data-test="source-row">
                        <span class="grid size-11 place-items-center rounded-xl bg-orange-50 text-orange-700 dark:bg-orange-500/10 dark:text-orange-400">
                            <twig:ux:icon name="tabler:rss" class="size-5"/>
                        </span>
                        <div class="flex min-w-0 flex-col gap-1">
                            <p class="text-[15px] font-semibold text-gray-900 dark:text-white" data-test="source-name">{{ source.name }}</p>
                            <p class="truncate font-mono text-xs text-gray-500 dark:text-gray-400" data-test="source-url">{{ source.feedUrl }}</p>
                            <div class="mt-0.5 flex flex-wrap items-center gap-1.5">
                                {% for category in source.categories %}
                                    <span class="rounded-full bg-gray-100 px-2.5 py-0.5 text-xs font-semibold text-gray-700 dark:bg-white/10 dark:text-gray-200">{{ category.name }}</span>
                                {% endfor %}
                                {% if source.active %}
                                    <span class="inline-flex items-center gap-1.5 text-xs font-semibold text-emerald-700 dark:text-emerald-400">
                                        <span class="relative size-[7px]" aria-hidden="true">
                                            <span class="absolute inset-0 animate-radar-ping rounded-full bg-emerald-600 dark:bg-emerald-500"></span>
                                            <span class="absolute inset-0 rounded-full bg-emerald-600 dark:bg-emerald-500"></span>
                                        </span>
                                        Actif
                                    </span>
                                {% endif %}
                            </div>
                            <p class="mt-1 text-xs text-gray-500 dark:text-gray-400" data-test="source-fetched">
                                {% if source.lastFetchedAt %}
                                    Dernière relève réussie le {{ source.lastFetchedAt|date('d/m/Y à H:i', 'Europe/Paris') }}
                                {% else %}
                                    Pas encore relevée
                                {% endif %}
                            </p>
                            {% if source.lastError %}
                                <p class="text-xs text-rose-700 dark:text-rose-400" data-test="source-error">
                                    Dernière erreur le {{ source.lastErrorAt|date('d/m/Y à H:i', 'Europe/Paris') }} : {{ source.lastError }}
                                </p>
                            {% endif %}
                        </div>
                        <div class="col-span-2 flex flex-wrap items-center gap-2 sm:col-span-1 sm:justify-end">
                            <form method="post" action="{{ path('app_source_fetch', {id: source.id}) }}" class="flex items-center gap-2">
                                <input type="hidden" name="_token" value="{{ csrf_token('source-fetch') }}">
                                <select name="since" data-test="source-since" aria-label="Reprendre aussi les articles parus depuis"
                                        title="Reprendre aussi les articles parus depuis, même déjà vus"
                                        class="select h-[38px] rounded-[10px] border border-gray-300 bg-white py-0 pr-9 pl-3 text-xs text-gray-700 focus:border-gray-900 focus:ring-1 focus:ring-gray-900 focus:outline-none dark:border-gray-700 dark:bg-gray-950 dark:text-gray-300 dark:focus:border-gray-400 dark:focus:ring-gray-400">
                                    {% for window in windows %}
                                        <option value="{{ window.value }}">{{ window.label }}</option>
                                    {% endfor %}
                                </select>
                                <button type="submit" data-test="source-fetch" title="Relever le flux maintenant, sans attendre la relève horaire"
                                        class="group inline-flex h-[38px] items-center gap-1.5 rounded-[10px] border border-gray-300 bg-white px-3 text-[13px] font-semibold text-gray-900 transition-colors hover:border-gray-400 focus:ring-4 focus:ring-gray-200 focus:outline-none dark:border-gray-700 dark:bg-gray-950 dark:text-white dark:hover:border-gray-500 dark:focus:ring-gray-800">
                                    <twig:ux:icon name="tabler:refresh" class="size-3.5 transition-transform duration-500 ease-[cubic-bezier(.3,1.4,.5,1)] group-hover:rotate-180 motion-reduce:transition-none"/> Relever
                                </button>
                            </form>
                            <form method="post" action="{{ path('app_source_remove', {id: source.id}) }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('source-remove') }}">
                                <button type="submit" data-test="source-remove"
                                        class="inline-flex h-[38px] items-center gap-1.5 rounded-[10px] px-3 text-[13px] font-semibold text-rose-700 transition-colors hover:bg-rose-50 focus:ring-4 focus:ring-rose-100 focus:outline-none dark:text-rose-400 dark:hover:bg-rose-900/30 dark:focus:ring-rose-900/40">
                                    <twig:ux:icon name="tabler:trash" class="size-3.5"/> Retirer
                                </button>
                            </form>
                        </div>
                    </li>
                {% else %}
                    <li class="px-4 py-6 text-center text-sm text-gray-500 dark:text-gray-400">Aucune source suivie pour l'instant.</li>
                {% endfor %}
            </ul>
        </section>
    </div>
{% endblock %}
