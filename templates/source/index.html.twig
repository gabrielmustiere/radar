{% extends 'base.html.twig' %}

{% block title %}Sources · Radar{% endblock %}

{% block body %}
    <div class="mx-auto max-w-3xl">
        <h1 class="font-display text-2xl font-bold tracking-tight text-gray-900 dark:text-white">Sources</h1>
        <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">
            Chaque nouvel article d'une source est publié automatiquement, dans ses catégories, et annoncé dans Google Chat.
            Les articles déjà présents dans le flux au moment de l'ajout sont ignorés : « Relever » permet d'aller chercher
            ceux parus sur les dernières heures.
        </p>

        {{ form_start(form, {attr: {class: 'mt-8 space-y-6', 'data-test': 'source-form', novalidate: 'novalidate'}}) }}
            {{ form_row(form.feedUrl) }}

            <fieldset data-test="source-categories">
                <legend class="mb-2 block text-sm font-medium text-gray-900 dark:text-gray-100">{{ form.categories.vars.label }}</legend>
                {% if form.categories|length > 0 %}
                    <div class="flex flex-wrap gap-2">
                        {% for choice in form.categories %}
                            <label class="cursor-pointer">
                                {# Case brute, sans l'enveloppe du thème Flowbite : elle doit rester sœur de la pastille pour que `peer-checked` s'applique #}
                                <input type="checkbox" id="{{ choice.vars.id }}" name="{{ choice.vars.full_name }}" value="{{ choice.vars.value }}" class="peer sr-only"
                                       {%- if choice.vars.checked %} checked{% endif %}>
                                {% do choice.setRendered %}
                                <span class="inline-flex items-center rounded-full bg-white px-3 py-1.5 text-sm text-gray-700 ring-1 ring-gray-200 transition hover:ring-gray-300 peer-checked:bg-gray-900 peer-checked:font-medium peer-checked:text-white peer-checked:ring-gray-900 peer-focus-visible:ring-2 dark:bg-gray-950 dark:text-gray-300 dark:ring-gray-800 dark:peer-checked:bg-white dark:peer-checked:text-gray-900 dark:peer-checked:ring-white">
                                    {{ choice.vars.label }}
                                </span>
                            </label>
                        {% endfor %}
                    </div>
                {% else %}
                    <p class="text-sm text-gray-500 dark:text-gray-400">Aucune catégorie pour l'instant : créez-en une en ajoutant un lien.</p>
                {% endif %}
                {{ form_errors(form.categories) }}
            </fieldset>

            <button type="submit" data-test="source-submit"
                    class="inline-flex items-center gap-2 rounded-xl bg-gray-900 px-5 py-2.5 text-sm font-medium text-white hover:bg-gray-700 focus:ring-4 focus:ring-gray-300 focus:outline-none dark:bg-white dark:text-gray-900 dark:hover:bg-gray-200 dark:focus:ring-gray-700">
                <twig:ux:icon name="tabler:rss" class="size-4"/> Suivre
            </button>
        {{ form_end(form) }}

        <ul class="mt-10 divide-y divide-gray-100 rounded-2xl ring-1 ring-gray-200/70 dark:divide-gray-800 dark:ring-gray-800" data-test="source-list">
            {% for source in sources %}
                <li class="flex items-start gap-4 px-4 py-4 text-sm" data-test="source-row">
                    <div class="min-w-0 flex-1">
                        <p class="font-medium text-gray-900 dark:text-white" data-test="source-name">{{ source.name }}</p>
                        <p class="truncate text-xs text-gray-500 dark:text-gray-400" data-test="source-url">{{ source.feedUrl }}</p>
                        <div class="mt-2 flex flex-wrap gap-1.5">
                            {% for category in source.categories %}
                                <span class="rounded-full bg-gray-100 px-2 py-0.5 text-xs font-medium text-gray-900 dark:bg-white/10 dark:text-white">{{ category.name }}</span>
                            {% endfor %}
                        </div>
                        <p class="mt-2 text-xs text-gray-500 dark:text-gray-400" data-test="source-fetched">
                            {% if source.lastFetchedAt %}
                                Dernière relève réussie le {{ source.lastFetchedAt|date('d/m/Y à H:i', 'Europe/Paris') }}
                            {% else %}
                                Pas encore relevée
                            {% endif %}
                        </p>
                        {% if source.lastError %}
                            <p class="mt-1 text-xs text-rose-700 dark:text-rose-400" data-test="source-error">
                                Dernière erreur le {{ source.lastErrorAt|date('d/m/Y à H:i', 'Europe/Paris') }} : {{ source.lastError }}
                            </p>
                        {% endif %}
                    </div>
                    <div class="flex shrink-0 items-center gap-1">
                        <form method="post" action="{{ path('app_source_fetch', {id: source.id}) }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('source-fetch') }}">
                            <div class="flex items-center rounded-lg ring-1 ring-gray-200 dark:ring-gray-800">
                                <select name="since" data-test="source-since" aria-label="Reprendre aussi les articles parus depuis"
                                        title="Reprendre aussi les articles parus depuis, même déjà vus"
                                        class="rounded-l-lg border-0 bg-transparent py-1 pr-6 pl-2 text-xs text-gray-700 focus:ring-1 focus:ring-gray-900 dark:text-gray-300 dark:focus:ring-gray-400">
                                    {% for window in windows %}
                                        <option value="{{ window.value }}">{{ window.label }}</option>
                                    {% endfor %}
                                </select>
                                <button type="submit" data-test="source-fetch" title="Relever le flux maintenant, sans attendre la relève horaire"
                                        class="inline-flex items-center gap-1 rounded-r-lg px-2 py-1 text-xs font-medium text-gray-600 hover:bg-gray-100 hover:text-gray-900 dark:text-gray-400 dark:hover:bg-white/10 dark:hover:text-white">
                                    <twig:ux:icon name="tabler:refresh" class="size-3.5"/> Relever
                                </button>
                            </div>
                        </form>
                        <form method="post" action="{{ path('app_source_remove', {id: source.id}) }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('source-remove') }}">
                            <button type="submit" data-test="source-remove"
                                    class="rounded-lg px-2 py-1 text-xs font-medium text-gray-600 hover:bg-gray-100 hover:text-gray-900 dark:text-gray-400 dark:hover:bg-white/10 dark:hover:text-white">
                                Retirer
                            </button>
                        </form>
                    </div>
                </li>
            {% else %}
                <li class="px-4 py-6 text-center text-sm text-gray-500 dark:text-gray-400">Aucune source suivie pour l'instant.</li>
            {% endfor %}
        </ul>
    </div>
{% endblock %}
