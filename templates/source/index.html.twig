{% extends 'base.html.twig' %}

{% block title %}Sources · Radar{% endblock %}

{% block body %}
    <div class="mx-auto max-w-3xl">
        <h1 class="font-display text-2xl font-bold tracking-tight text-gray-900 dark:text-white">Sources</h1>
        <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">
            Chaque nouvel article d'une source est publié automatiquement, dans ses catégories, et annoncé dans Google Chat.
            Les articles déjà présents dans le flux au moment de l'ajout sont ignorés : « Relever » permet d'aller chercher
            ceux parus sur les dernières heures.
        </p>

        <twig:SourceForm :form="form"/>

        <ul class="mt-10 divide-y divide-gray-100 rounded-2xl ring-1 ring-gray-200/70 dark:divide-gray-800 dark:ring-gray-800" data-test="source-list">
            {% for source in sources %}
                <li class="flex flex-wrap items-start gap-x-4 gap-y-3 px-4 py-4 text-sm" data-test="source-row">
                    <div class="min-w-0 flex-1 basis-64">
                        <p class="font-medium text-gray-900 dark:text-white" data-test="source-name">{{ source.name }}</p>
                        <p class="truncate text-xs text-gray-500 dark:text-gray-400" data-test="source-url">{{ source.feedUrl }}</p>
                        <div class="mt-2 flex flex-wrap gap-1.5">
                            {% for category in source.categories %}
                                <span class="rounded-full bg-gray-100 px-2 py-0.5 text-xs font-medium text-gray-900 dark:bg-white/10 dark:text-white">{{ category.name }}</span>
                            {% endfor %}
                        </div>
                        <p class="mt-2 text-xs text-gray-500 dark:text-gray-400" data-test="source-fetched">
                            {% if source.lastFetchedAt %}
                                Dernière relève réussie le {{ source.lastFetchedAt|date('d/m/Y à H:i', 'Europe/Paris') }}
                            {% else %}
                                Pas encore relevée
                            {% endif %}
                        </p>
                        {% if source.lastError %}
                            <p class="mt-1 text-xs text-rose-700 dark:text-rose-400" data-test="source-error">
                                Dernière erreur le {{ source.lastErrorAt|date('d/m/Y à H:i', 'Europe/Paris') }} : {{ source.lastError }}
                            </p>
                        {% endif %}
                    </div>
                    <div class="flex shrink-0 flex-wrap items-center gap-2">
                        <form method="post" action="{{ path('app_source_fetch', {id: source.id}) }}" class="flex items-center gap-2">
                            <input type="hidden" name="_token" value="{{ csrf_token('source-fetch') }}">
                            <select name="since" data-test="source-since" aria-label="Reprendre aussi les articles parus depuis"
                                    title="Reprendre aussi les articles parus depuis, même déjà vus"
                                    class="select rounded-xl border border-gray-200 bg-white py-1.5 pr-9 pl-3 text-xs text-gray-700 shadow-xs focus:border-gray-900 focus:ring-1 focus:ring-gray-900 focus:outline-none dark:border-gray-700 dark:bg-gray-950 dark:text-gray-300 dark:focus:border-gray-400 dark:focus:ring-gray-400">
                                {% for window in windows %}
                                    <option value="{{ window.value }}">{{ window.label }}</option>
                                {% endfor %}
                            </select>
                            <twig:Button type="submit" variant="outline" size="xs" data-test="source-fetch" title="Relever le flux maintenant, sans attendre la relève horaire" class="gap-1.5 rounded-xl">
                                <twig:ux:icon name="tabler:refresh" class="size-3.5"/> Relever
                            </twig:Button>
                        </form>
                        <form method="post" action="{{ path('app_source_remove', {id: source.id}) }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('source-remove') }}">
                            <twig:Button type="submit" variant="outline" size="xs" data-test="source-remove" class="gap-1.5 rounded-xl">
                                <twig:ux:icon name="tabler:trash" class="size-3.5"/> Retirer
                            </twig:Button>
                        </form>
                    </div>
                </li>
            {% else %}
                <li class="px-4 py-6 text-center text-sm text-gray-500 dark:text-gray-400">Aucune source suivie pour l'instant.</li>
            {% endfor %}
        </ul>
    </div>
{% endblock %}
