    {% block stylesheets %}{% endblock %}

    {% block javascripts %}
        {% block importmap %}{{ importmap('app') }}{% endblock %}
    {% endblock %}
</head>
<body class="h-full bg-gray-50 font-body text-gray-800 antialiased dark:bg-gray-950 dark:text-gray-200">

