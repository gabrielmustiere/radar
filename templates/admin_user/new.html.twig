{% extends 'base.html.twig' %}

{% block title %}Nouveau compte · Radar{% endblock %}

{% block body %}
    <div class="mx-auto flex max-w-2xl flex-col gap-6">
        {% include 'admin/_tabs.html.twig' %}

        <a href="{{ path('app_admin_user_index') }}" class="inline-flex items-center gap-1.5 self-start text-sm font-semibold text-gray-700 hover:text-gray-900 dark:text-gray-300 dark:hover:text-white">
            <twig:ux:icon name="tabler:arrow-left" class="size-4"/> Comptes
        </a>
        <div class="flex flex-col gap-1.5">
            <h1 class="font-display text-3xl font-bold tracking-tight text-gray-900 dark:text-white">Nouveau compte</h1>
            <p class="text-[15px] text-gray-500 dark:text-gray-400">
                La personne se connecte avec son email et le mot de passe provisoire que vous lui transmettez.
            </p>
        </div>

        {{ form_start(form, {attr: {class: 'flex flex-col gap-2 rounded-[20px] bg-white p-6 ring-1 ring-gray-200/70 dark:bg-gray-900 dark:ring-gray-800', 'data-test': 'user-form', novalidate: 'novalidate'}}) }}
            {{ form_row(form.email) }}
            {{ form_row(form.team) }}
            {{ form_row(form.password) }}
            <div class="rounded-xl bg-gray-50 px-3.5 pt-3.5 pb-0.5 dark:bg-white/5">
                {{ form_row(form.admin) }}
            </div>
            {{ form_rest(form) }}

            <div class="mt-3 border-t border-gray-100 pt-5 dark:border-gray-800">
                <button type="submit" data-test="user-submit"
                        class="inline-flex h-[46px] items-center gap-2 rounded-xl bg-gray-900 px-5 text-[15px] font-semibold text-white transition hover:-translate-y-px hover:bg-gray-700 focus:ring-4 focus:ring-gray-300 focus:outline-none motion-reduce:hover:translate-y-0 dark:bg-white dark:text-gray-900 dark:hover:bg-gray-200 dark:focus:ring-gray-700">
                    <twig:ux:icon name="tabler:user-plus" class="size-4"/> Créer le compte
                </button>
            </div>
        {{ form_end(form) }}
    </div>
{% endblock %}
