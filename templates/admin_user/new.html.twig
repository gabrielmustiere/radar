{% extends 'base.html.twig' %}

{% block title %}Nouveau compte · Radar{% endblock %}

{% block body %}
    <div class="mx-auto max-w-2xl">
        <a href="{{ path('app_admin_user_index') }}" class="inline-flex items-center gap-1 text-sm text-gray-500 hover:text-gray-900 dark:text-gray-400 dark:hover:text-white">
            <twig:ux:icon name="tabler:arrow-left" class="size-4"/> Comptes
        </a>
        <h1 class="mt-2 font-display text-2xl font-bold tracking-tight text-gray-900 dark:text-white">Nouveau compte</h1>
        <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">
            La personne se connecte avec son email et le mot de passe provisoire que vous lui transmettez.
        </p>

        {{ form_start(form, {attr: {class: 'mt-8 space-y-6 rounded-2xl p-5 ring-1 ring-gray-200/70 sm:p-6 dark:ring-gray-800', 'data-test': 'user-form', novalidate: 'novalidate'}}) }}
            {{ form_row(form.email) }}
            {{ form_row(form.team) }}
            {{ form_row(form.password) }}
            {{ form_row(form.admin) }}
            {{ form_rest(form) }}

            <button type="submit" data-test="user-submit"
                    class="inline-flex items-center gap-2 rounded-xl bg-gray-900 px-5 py-2.5 text-sm font-medium text-white hover:bg-gray-700 focus:ring-4 focus:ring-gray-300 focus:outline-none dark:bg-white dark:text-gray-900 dark:hover:bg-gray-200 dark:focus:ring-gray-700">
                <twig:ux:icon name="tabler:user-plus" class="size-4"/> Créer le compte
            </button>
        {{ form_end(form) }}
    </div>
{% endblock %}
