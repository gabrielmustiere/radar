{% extends 'base.html.twig' %}

{% block title %}Catégories · Radar{% endblock %}

{% block body %}
    <div class="mx-auto max-w-3xl">
        <div class="flex items-center gap-3">
            <h1 class="font-display text-2xl font-bold tracking-tight text-gray-900 dark:text-white">Catégories</h1>
            <span class="text-sm text-gray-500 dark:text-gray-400" data-test="category-count">{{ categories|length }} catégorie{{ categories|length > 1 ? 's' }}</span>
        </div>
        <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">
            Une catégorie prend l'équipe de la personne qui la crée. Les membres de cette équipe la voient en tête de leur sidebar, et tout le monde la voit.
        </p>

        <ul class="mt-8 divide-y divide-gray-100 rounded-2xl ring-1 ring-gray-200/70 dark:divide-gray-800 dark:ring-gray-800" data-test="category-list">
            {% for category in categories %}
                {% set linkCount = linkCounts[category.id] ?? 0 %}
                <li class="flex flex-wrap items-center gap-x-4 gap-y-3 px-4 py-3.5 text-sm" data-test="category-row">
                    <div class="min-w-0 flex-1 basis-48">
                        <a href="{{ path('app_category_show', {id: category.id}) }}" class="block truncate font-medium text-gray-900 hover:underline dark:text-white" data-test="category-name">{{ category.name }}</a>
                        <p class="mt-0.5 text-xs text-gray-500 dark:text-gray-400">
                            <span data-test="category-link-count">{{ linkCount }}</span> lien{{ linkCount > 1 ? 's' }}
                        </p>
                    </div>
                    <form method="post" action="{{ path('app_admin_category_team', {id: category.id}) }}" class="flex shrink-0 items-center gap-2">
                        <input type="hidden" name="_token" value="{{ csrf_token('category-team') }}">
                        <select name="team" data-test="category-team" aria-label="Équipe de « {{ category.name }} »"
                                class="select w-40 rounded-xl border border-gray-200 bg-white py-1.5 pr-9 pl-3 text-sm text-gray-900 shadow-xs focus:border-gray-900 focus:ring-1 focus:ring-gray-900 focus:outline-none dark:border-gray-700 dark:bg-gray-950 dark:text-white dark:focus:border-gray-400 dark:focus:ring-gray-400">
                            <option value="">Aucune équipe</option>
                            {% for team in teams %}
                                <option value="{{ team.value }}" {{ category.team == team ? 'selected' }}>{{ team.label }}</option>
                            {% endfor %}
                        </select>
                        <twig:Button type="submit" variant="outline" size="sm" data-test="category-team-submit" class="gap-1.5 rounded-xl py-1.5">
                            <twig:ux:icon name="tabler:check" class="size-3.5"/> Enregistrer
                        </twig:Button>
                    </form>
                </li>
            {% else %}
                <li class="px-4 py-6 text-center text-sm text-gray-500 dark:text-gray-400">Aucune catégorie pour l'instant.</li>
            {% endfor %}
        </ul>
    </div>
{% endblock %}
