{% extends 'base.html.twig' %}

{% block title %}Catégories · Radar{% endblock %}

{% block body %}
    {% set max_count = max([1]|merge(linkCounts)) %}
    <div class="mx-auto flex max-w-3xl flex-col gap-6">
        {% include 'admin/_tabs.html.twig' %}

        <div class="flex flex-col gap-2">
            <div class="flex items-baseline gap-3">
                <h1 class="font-display text-3xl font-bold tracking-tight text-gray-900 dark:text-white">Catégories</h1>
                <span class="text-sm font-medium text-gray-500 dark:text-gray-400" data-test="category-count">{{ categories|length }} catégorie{{ categories|length > 1 ? 's' }}</span>
            </div>
            <p class="max-w-[680px] text-[15px] leading-relaxed text-gray-500 dark:text-gray-400">
                Une catégorie prend l'équipe de la personne qui la crée. Les membres de cette équipe la voient en tête de leurs filtres, et tout le monde la voit.
            </p>
        </div>

        <ul class="divide-y divide-gray-100 overflow-hidden rounded-[20px] bg-white ring-1 ring-gray-200/70 dark:divide-gray-800 dark:bg-gray-900 dark:ring-gray-800" data-test="category-list">
            {% for category in categories %}
                {% set linkCount = linkCounts[category.id] ?? 0 %}
                <li class="flex flex-wrap items-center gap-x-3.5 gap-y-3 px-4.5 py-4 text-sm transition-colors hover:bg-gray-50/70 dark:hover:bg-white/[0.03]" data-test="category-row">
                    <div class="flex min-w-0 flex-1 basis-48 flex-col gap-1.5">
                        <a href="{{ path('app_category_show', {id: category.id}) }}" class="block truncate text-[15px] font-semibold text-gray-900 underline-offset-[3px] hover:underline dark:text-white" data-test="category-name">{{ category.name }}</a>
                        <p class="flex items-center gap-2 text-xs text-gray-500 dark:text-gray-400">
                            <span class="block h-1.5 w-30 overflow-hidden rounded-full bg-gray-100 dark:bg-gray-800" aria-hidden="true">
                                <span class="block h-full origin-left animate-radar-grow rounded-full bg-gray-900 dark:bg-gray-300" style="width: {{ (linkCount / max_count * 100)|round }}%"></span>
                            </span>
                            <span><span data-test="category-link-count">{{ linkCount }}</span> lien{{ linkCount > 1 ? 's' }}</span>
                        </p>
                    </div>
                    <form method="post" action="{{ path('app_admin_category_team', {id: category.id}) }}" class="flex shrink-0 items-center gap-2">
                        <input type="hidden" name="_token" value="{{ csrf_token('category-team') }}">
                        <select name="team" data-test="category-team" aria-label="Équipe de « {{ category.name }} »"
                                class="select h-10 w-[200px] rounded-[10px] border border-gray-300 bg-white py-0 pr-9 pl-2.5 text-sm text-gray-900 focus:border-gray-900 focus:ring-1 focus:ring-gray-900 focus:outline-none dark:border-gray-700 dark:bg-gray-950 dark:text-white dark:focus:border-gray-400 dark:focus:ring-gray-400">
                            <option value="">Aucune équipe</option>
                            {% for team in teams %}
                                <option value="{{ team.value }}" {{ category.team == team ? 'selected' }}>{{ team.label }}</option>
                            {% endfor %}
                        </select>
                        <twig:Button type="submit" variant="outline" size="sm" data-test="category-team-submit"
                                     class="h-10 gap-1.5 rounded-[10px] px-3.5 py-0 font-semibold shadow-none hover:border-gray-900 hover:bg-gray-900 hover:text-white dark:hover:border-white dark:hover:bg-white dark:hover:text-gray-900">
                            <twig:ux:icon name="tabler:check" class="size-3.5"/> Enregistrer
                        </twig:Button>
                    </form>
                </li>
            {% else %}
                <li class="px-4 py-6 text-center text-sm text-gray-500 dark:text-gray-400">Aucune catégorie pour l'instant.</li>
            {% endfor %}
        </ul>
    </div>
{% endblock %}
