{# Les catégories non cochées sont grisées une fois le maximum atteint (LinkSubmission::MAX_CATEGORIES). #}
{% set duplicate = this.duplicate %}
{% set category_limit_reached = this.categoryCount >= constant('App\\Form\\Model\\LinkSubmission::MAX_CATEGORIES') %}
<div {{ attributes }}>
    {% if duplicate %}
        {% include 'link/_duplicate.html.twig' %}
    {% endif %}

    {{ form_start(form, {action: path(historical ? 'app_link_seed' : 'app_link_new'), attr: {class: 'mt-8 space-y-6', 'data-test': 'link-form', novalidate: 'novalidate'}}) }}
        {{ form_row(form.url, {attr: {'data-model': 'debounce(400)|' ~ form.url.vars.full_name}}) }}

        <fieldset data-test="link-categories">
            <legend class="mb-2 block text-sm font-medium text-gray-900 dark:text-gray-100">{{ form.categories.vars.label }}</legend>
            {% if form.categories|length > 0 %}
                <div class="flex flex-wrap gap-2">
                    {% for choice in form.categories %}
                        {% set locked = category_limit_reached and not choice.vars.checked %}
                        <label class="{{ locked ? 'cursor-not-allowed' : 'cursor-pointer' }}" {% if locked %}title="Deux catégories au plus"{% endif %}>
                            {{ form_widget(choice, {attr: {class: 'peer sr-only', disabled: locked}, label: false}) }}
                            <span class="inline-flex items-center rounded-full bg-white px-3 py-1.5 text-sm text-gray-700 ring-1 ring-gray-200 transition hover:ring-gray-300 peer-checked:bg-teal-50 peer-checked:font-medium peer-checked:text-teal-800 peer-checked:ring-teal-500 peer-focus-visible:ring-2 peer-disabled:opacity-40 peer-disabled:hover:ring-gray-200 dark:bg-gray-950 dark:text-gray-300 dark:ring-gray-800 dark:peer-checked:bg-teal-500/10 dark:peer-checked:text-teal-300">
                                {{ choice.vars.label }}
                            </span>
                        </label>
                    {% endfor %}
                </div>
            {% else %}
                <p class="text-sm text-gray-500 dark:text-gray-400">Aucune catégorie pour l'instant : créez la première ci-dessous.</p>
            {% endif %}
            {{ form_errors(form.categories) }}
        </fieldset>

        {{ form_row(form.newCategory) }}
        {{ form_row(form.context) }}

        {% if historical %}
            <div class="grid gap-4 sm:grid-cols-2">
                {{ form_row(form.postedAt) }}
                {{ form_row(form.poster) }}
            </div>
        {% endif %}

        <div class="flex items-center gap-3">
            <button type="submit" data-test="link-submit" {% if duplicate %}disabled{% endif %}
                    class="inline-flex items-center gap-2 rounded-xl bg-teal-600 px-5 py-2.5 text-sm font-medium text-white hover:bg-teal-700 focus:ring-4 focus:ring-teal-200 focus:outline-none disabled:cursor-not-allowed disabled:opacity-50 disabled:hover:bg-teal-600 dark:focus:ring-teal-900">
                {% if historical %}
                    <twig:ux:icon name="tabler:history" class="size-4"/> Reprendre
                {% else %}
                    <twig:ux:icon name="tabler:plus" class="size-4"/> Ajouter
                {% endif %}
            </button>
            {% if historical %}
                <a href="{{ path('app_link_new') }}" class="text-sm font-medium text-gray-600 hover:text-gray-900 dark:text-gray-400 dark:hover:text-white">Annuler</a>
            {% else %}
                {# Dans la modale : la ferme ; sur la page dédiée : retour au fil #}
                <a href="{{ path('app_page') }}" data-turbo-frame="_top" data-action="link-modal#close:prevent" data-test="link-cancel"
                   class="text-sm font-medium text-gray-600 hover:text-gray-900 dark:text-gray-400 dark:hover:text-white">Annuler</a>
                <a href="{{ path('app_link_seed') }}" data-test="link-seed-entry"
                   class="ml-auto text-sm font-medium text-teal-700 hover:underline dark:text-teal-400">Reprendre un lien de Chat</a>
            {% endif %}
            <twig:ux:icon name="tabler:loader-2" class="size-4 animate-spin text-teal-600" data-loading="delay|show" hidden/>
        </div>
    {{ form_end(form) }}
</div>
