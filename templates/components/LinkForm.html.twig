{% set duplicate = this.duplicate %}
{% set detected = historical ? null : this.detectedType %}
{# Couleur pleine du type, comme le badge des cartes #}
{% set detected_colors = {
    youtube: 'bg-rose-600',
    github: 'bg-violet-600',
    x: 'bg-sky-700',
    article: 'bg-teal-700',
    image: 'bg-gray-900 dark:bg-gray-700',
} %}
<div {{ attributes }}>
    {{ form_start(form, {action: path(historical ? 'app_link_seed' : 'app_link_new'), attr: {class: 'mt-6 space-y-6', 'data-test': 'link-form', novalidate: 'novalidate'}}) }}
        {# Adresse d'abord : le type reconnu s'affiche à côté du libellé dès la saisie #}
        <div>
            <div class="flex items-center justify-between gap-3">
                {{ form_label(form.url) }}
                {% if detected %}
                    <span class="mb-2 inline-flex h-6 animate-radar-badge items-center rounded-full px-2.5 text-[11px] font-bold tracking-wide text-white uppercase {{ detected_colors[detected.value] }}" data-test="link-detected-type">{{ detected.label }}</span>
                {% endif %}
            </div>
            {{ form_widget(form.url, {attr: {'data-model': 'debounce(400)|' ~ form.url.vars.full_name}}) }}
            {{ form_help(form.url) }}
            {{ form_errors(form.url) }}
        </div>

        {% if duplicate %}
            {% include 'link/_duplicate.html.twig' %}
        {% endif %}

        {% include 'components/_category_picker.html.twig' with {field: form.categories, test_id: 'link-categories'} %}

        {{ form_row(form.context) }}

        {% if historical %}
            <div class="grid gap-4 sm:grid-cols-2">
                {{ form_row(form.postedAt) }}
                {{ form_row(form.poster) }}
            </div>
            <p class="flex gap-2.5 rounded-xl bg-sky-50 px-4 py-3 text-sm text-sky-900 ring-1 ring-sky-100 dark:bg-sky-500/10 dark:text-sky-200 dark:ring-sky-500/20" data-test="link-seed-info">
                <twig:ux:icon name="tabler:info-circle" class="mt-0.5 size-4 shrink-0"/>
                Le lien garde sa date et son posteur d'origine, et n'est pas réannoncé dans Google Chat.
            </p>
        {% endif %}

        <div class="flex items-center gap-3">
            <button type="submit" data-test="link-submit" {% if duplicate %}disabled{% endif %}
                    class="inline-flex items-center gap-2 rounded-xl bg-gray-900 px-5 py-2.5 text-sm font-medium text-white hover:bg-gray-700 focus:ring-4 focus:ring-gray-300 focus:outline-none disabled:cursor-not-allowed disabled:opacity-50 disabled:hover:bg-gray-900 dark:bg-white dark:text-gray-900 dark:hover:bg-gray-200 dark:focus:ring-gray-700 dark:disabled:hover:bg-white">
                {% if historical %}
                    <twig:ux:icon name="tabler:history" class="size-4"/> Reprendre
                {% else %}
                    <twig:ux:icon name="tabler:plus" class="size-4"/> Ajouter
                {% endif %}
            </button>
            {% if historical %}
                <a href="{{ path('app_link_new') }}" class="text-sm font-medium text-gray-600 hover:text-gray-900 dark:text-gray-400 dark:hover:text-white">Annuler</a>
            {% else %}
                {# Dans la modale : la ferme ; sur la page dédiée : retour au fil #}
                <a href="{{ path('app_page') }}" data-turbo-frame="_top" data-action="link-modal#close:prevent" data-test="link-cancel"
                   class="text-sm font-medium text-gray-600 hover:text-gray-900 dark:text-gray-400 dark:hover:text-white">Annuler</a>
                <a href="{{ path('app_link_seed') }}" data-test="link-seed-entry"
                   class="ml-auto inline-flex items-center gap-1 text-sm font-semibold text-gray-900 hover:underline dark:text-white">Reprendre un lien de Chat <twig:ux:icon name="tabler:arrow-right" class="size-4"/></a>
            {% endif %}
            <twig:ux:icon name="tabler:loader-2" class="size-4 animate-spin text-gray-900 dark:text-white" data-loading="delay|show" hidden/>
        </div>
    {{ form_end(form) }}
</div>
