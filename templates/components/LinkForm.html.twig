{% set duplicate = this.duplicate %}
<div {{ attributes }}>
    {{ form_start(form, {action: path(historical ? 'app_link_seed' : 'app_link_new'), attr: {class: 'mt-8 space-y-6', 'data-test': 'link-form', novalidate: 'novalidate'}}) }}
        {{ form_row(form.context) }}

        {% include 'components/_category_picker.html.twig' with {field: form.categories, test_id: 'link-categories'} %}

        {{ form_row(form.url, {attr: {'data-model': 'debounce(400)|' ~ form.url.vars.full_name}}) }}

        {% if duplicate %}
            {% include 'link/_duplicate.html.twig' %}
        {% endif %}

        {% if historical %}
            <div class="grid gap-4 sm:grid-cols-2">
                {{ form_row(form.postedAt) }}
                {{ form_row(form.poster) }}
            </div>
        {% endif %}

        <div class="flex items-center gap-3">
            <button type="submit" data-test="link-submit" {% if duplicate %}disabled{% endif %}
                    class="inline-flex items-center gap-2 rounded-xl bg-gray-900 px-5 py-2.5 text-sm font-medium text-white hover:bg-gray-700 focus:ring-4 focus:ring-gray-300 focus:outline-none disabled:cursor-not-allowed disabled:opacity-50 disabled:hover:bg-gray-900 dark:bg-white dark:text-gray-900 dark:hover:bg-gray-200 dark:focus:ring-gray-700 dark:disabled:hover:bg-white">
                {% if historical %}
                    <twig:ux:icon name="tabler:history" class="size-4"/> Reprendre
                {% else %}
                    <twig:ux:icon name="tabler:plus" class="size-4"/> Ajouter
                {% endif %}
            </button>
            {% if historical %}
                <a href="{{ path('app_link_new') }}" class="text-sm font-medium text-gray-600 hover:text-gray-900 dark:text-gray-400 dark:hover:text-white">Annuler</a>
            {% else %}
                {# Dans la modale : la ferme ; sur la page dédiée : retour au fil #}
                <a href="{{ path('app_page') }}" data-turbo-frame="_top" data-action="link-modal#close:prevent" data-test="link-cancel"
                   class="text-sm font-medium text-gray-600 hover:text-gray-900 dark:text-gray-400 dark:hover:text-white">Annuler</a>
                <a href="{{ path('app_link_seed') }}" data-test="link-seed-entry"
                   class="ml-auto text-sm font-medium text-gray-900 hover:underline dark:text-white">Reprendre un lien de Chat</a>
            {% endif %}
            <twig:ux:icon name="tabler:loader-2" class="size-4 animate-spin text-gray-900 dark:text-white" data-loading="delay|show" hidden/>
        </div>
    {{ form_end(form) }}
</div>
