{% macro category_list(categories, currentId, showTeam) %}
    <ul class="space-y-1">
        {% for category in categories %}
            {% set active = category.id == currentId %}
            <li>
                <a href="{{ path('app_category_show', {id: category.id}) }}"
                   {% if active %}aria-current="page"{% endif %}
                   title="{{ category.name }}{{ showTeam and category.team ? ' · ' ~ category.team.label }}"
                   data-test="category-nav-item"
                   class="flex items-center gap-3 rounded-xl px-3 py-2 text-sm transition {{ active ? 'bg-white font-semibold text-gray-900 shadow-xs ring-1 ring-gray-200/70 dark:bg-gray-900 dark:text-white dark:ring-gray-800' : 'font-medium text-gray-700 hover:bg-white hover:text-gray-900 dark:text-gray-300 dark:hover:bg-gray-900 dark:hover:text-white' }}">
                    <twig:ux:icon name="tabler:folder" class="size-4 shrink-0"/>
                    <span class="flex-1 truncate">{{ category.name }}</span>
                    {% if showTeam and category.team %}
                        <twig:Badge variant="gray" class="shrink-0 px-1 py-0 text-2xs font-normal text-gray-500 ring-1 ring-gray-200 dark:text-gray-400 dark:ring-gray-800" data-test="category-nav-team">{{ category.team.label }}</twig:Badge>
                    {% endif %}
                    <span class="text-xs text-gray-400 tabular-nums dark:text-gray-500">{{ category.linkCount }}</span>
                </a>
            </li>
        {% endfor %}
    </ul>
{% endmacro %}

{% set heading = 'px-3 pb-2 text-xs font-semibold tracking-wide text-gray-500 uppercase dark:text-gray-400' %}
{% set sections = this.sections %}
<div {{ attributes.defaults({class: 'mt-4 border-t border-gray-200 pt-4 dark:border-gray-800', 'data-test': 'category-nav'}) }}>
    {% if sections.mine is not empty %}
        <div data-test="category-nav-mine">
            <p class="{{ heading }}">Mon équipe <span class="font-normal normal-case tracking-normal" data-test="category-nav-mine-team">· {{ app.user.team.label }}</span></p>
            {{ _self.category_list(sections.mine, currentId, false) }}
        </div>
        {% if sections.others is not empty %}
            <div class="mt-4" data-test="category-nav-others">
                <p class="{{ heading }}">Autres catégories</p>
                {{ _self.category_list(sections.others, currentId, true) }}
            </div>
        {% endif %}
    {% else %}
        <div data-test="category-nav-others">
            <p class="{{ heading }}">Catégories</p>
            {% if sections.others is empty %}
                <p class="px-3 text-sm text-gray-500 dark:text-gray-400">Aucune pour l'instant.</p>
            {% else %}
                {{ _self.category_list(sections.others, currentId, true) }}
            {% endif %}
        </div>
    {% endif %}
</div>
