<div {{ attributes }}>
    <form action="{{ path('app_search') }}" method="GET" role="search" class="max-w-xl" data-action="live#$render:prevent">
        <label for="search-q" class="sr-only">Rechercher</label>
        <div class="relative">
            <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3">
                <twig:ux:icon name="tabler:search" class="size-4 text-gray-400"/>
            </div>
            <input type="search" name="q" id="search-q" value="{{ q }}" data-test="search-input" autofocus
                   data-model="debounce(300)|q" autocomplete="off"
                   class="block w-full rounded-xl border-0 bg-gray-50 py-2.5 pr-10 pl-9 text-sm text-gray-900 ring-1 ring-gray-200 placeholder:text-gray-400 focus:ring-2 focus:ring-teal-500 focus:outline-none dark:bg-gray-950 dark:text-white dark:ring-gray-800"
                   placeholder="Un mot du titre, du contexte, une catégorie…"/>
            <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center pr-3" data-loading="delay|show" hidden>
                <twig:ux:icon name="tabler:loader-2" class="size-4 animate-spin text-teal-600"/>
            </div>
        </div>
    </form>

    {% set query = this.query %}
    <div data-loading="delay|addClass(opacity-50)" class="transition-opacity" data-test="search-results">
        {% if query.empty %}
            <p class="mt-10 text-sm text-gray-600 dark:text-gray-400" data-test="search-hint">
                Saisissez au moins un mot de deux lettres : titre, description, contexte, adresse ou catégorie.
            </p>
        {% else %}
            {% set links = this.links %}
            <div class="mt-8 flex items-center gap-3">
                <h1 class="font-display text-2xl font-bold tracking-tight text-gray-900 dark:text-white">Résultats pour « {{ q }} »</h1>
                <span class="size-1 rounded-full bg-gray-400"></span>
                <span class="text-sm text-gray-500 dark:text-gray-400" data-test="link-count">{{ links.totalCount }} lien{{ links.totalCount > 1 ? 's' }}</span>
            </div>

            {% if links.items is empty %}
                <div class="py-16 text-center" data-test="search-empty">
                    <p class="text-sm text-gray-700 dark:text-gray-300">Aucun lien ne contient tous ces mots.</p>
                    <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">Essayez moins de mots, ou parcourez les catégories dans la barre latérale.</p>
                </div>
            {% else %}
                <div class="mt-8 grid gap-5 sm:grid-cols-2 xl:grid-cols-3" data-test="link-list">
                    {% for link in links.items %}
                        {% include 'link/_list_card.html.twig' %}
                    {% endfor %}
                </div>
                {% include 'link/_pager.html.twig' with {pager_route: 'app_search', pager_params: {q: q}} %}
            {% endif %}
        {% endif %}
    </div>
</div>
