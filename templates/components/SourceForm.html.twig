<div {{ attributes }}>
    {{ form_start(form, {action: path('app_source_index'), attr: {class: 'flex flex-col gap-2 rounded-[20px] bg-white p-6 ring-1 ring-gray-200/70 dark:bg-gray-900 dark:ring-gray-800', 'data-test': 'source-form', novalidate: 'novalidate'}}) }}
        {{ form_row(form.feedUrl) }}

        {% include 'components/_category_picker.html.twig' with {field: form.categories, test_id: 'source-categories'} %}

        <div class="mt-3 flex items-center gap-3">
            <button type="submit" data-test="source-submit"
                    class="inline-flex h-[46px] items-center gap-2 rounded-xl bg-orange-700 px-5 text-[15px] font-semibold text-white transition hover:-translate-y-px hover:bg-orange-800 focus:ring-4 focus:ring-orange-200 focus:outline-none motion-reduce:hover:translate-y-0 dark:bg-orange-600 dark:hover:bg-orange-500 dark:focus:ring-orange-900/50">
                <twig:ux:icon name="tabler:rss" class="size-4"/> Suivre
            </button>
            <twig:ux:icon name="tabler:loader-2" class="size-4 animate-spin text-gray-900 dark:text-white" data-loading="delay|show" hidden/>
        </div>
    {{ form_end(form) }}
</div>
