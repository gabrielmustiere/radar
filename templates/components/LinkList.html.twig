{% set query = this.query %}
{% set links = this.results %}
<div {{ attributes.defaults({class: 'transition-opacity duration-200'}) }} data-loading="delay|addClass(opacity-60)">
    <div class="flex items-center gap-3">
        <h1 class="font-display text-2xl font-bold tracking-tight text-gray-900 dark:text-white">{{ category ? category.name : 'Tous les liens' }}</h1>
        {% if category and is_granted('RADAR_ADMIN') %}
            <twig:Modal id="category-rename" class="-ml-2">
                <twig:Modal:Trigger>
                    <button type="button" data-test="category-rename" title="Renommer la catégorie"
                            data-action="flowbite-modal#open" data-flowbite-modal-target="trigger" aria-haspopup="dialog"
                            class="grid size-8 place-items-center rounded-lg text-gray-400 hover:bg-gray-100 hover:text-gray-900 dark:hover:bg-gray-800 dark:hover:text-white">
                        <twig:ux:icon name="tabler:edit" class="size-4"/>
                        <span class="sr-only">Renommer la catégorie</span>
                    </button>
                </twig:Modal:Trigger>
                <twig:Modal:Content class="w-[calc(100%-2rem)] max-w-md rounded-3xl border-0 p-6 shadow-2xl ring-1 ring-gray-200/70 sm:p-8 dark:ring-gray-800">
                    <twig:Modal:Header class="border-0 pb-4 md:pb-4">
                        <twig:Modal:Title class="font-display text-lg font-semibold">Renommer la catégorie</twig:Modal:Title>
                    </twig:Modal:Header>
                    <twig:CategoryRenameForm :category="category"/>
                </twig:Modal:Content>
            </twig:Modal>
        {% endif %}
        <span class="size-1 rounded-full bg-gray-400"></span>
        {% include 'link/_count.html.twig' %}
    </div>

    {% if links.items is empty and not query.empty %}
        {% include 'link/_search_empty.html.twig' %}
    {% elseif links.items is empty and category %}
        <p class="py-16 text-center text-sm text-gray-700 dark:text-gray-300">Aucun lien dans cette catégorie pour l'instant.</p>
    {% elseif links.items is empty %}
        <div class="flex flex-col items-center py-16 text-center md:py-24">
            <twig:ux:icon name="doodles:laying" class="h-auto w-full max-w-md text-gray-900 dark:text-gray-200" aria-hidden="true"/>
            <p class="mt-6 text-sm text-gray-700 dark:text-gray-300">
                Rien ici pour l'instant : les liens repérés par l'équipe apparaîtront ici.
            </p>
        </div>
    {% else %}
        {# Autant de colonnes que la largeur le permet : une carte reste entre 280 px et ~580 px, sous les 600 px des visuels conservés #}
        <div class="mt-8 grid grid-cols-[repeat(auto-fill,minmax(min(100%,17.5rem),1fr))] gap-5" data-controller="masonry" data-test="link-list">
            {% for link in links.items %}
                <div class="min-w-0 self-start" data-masonry-target="item">
                    {% include 'link/_list_card.html.twig' %}
                </div>
            {% endfor %}
        </div>
    {% endif %}
    {% if links.items is not empty %}
        {# Rendu live, la requête courante est celle du composant : route et paramètres passés au pager #}
        {% include 'link/_pager.html.twig' with {
            pager_route: category ? 'app_category_show' : 'app_page',
            pager_params: (category ? {id: category.id} : {})|merge(q is empty ? {} : {q: q}),
        } %}
    {% endif %}
</div>
