{#
    Saisie des catégories d'un composant Live qui utilise CategoryPickerTrait.
    Paramètres : `field` (le champ `categories` du formulaire), `test_id` (data-test du fieldset).
    Une pastille filtrée est masquée, jamais retirée : cochée, elle doit partir avec le formulaire.
#}
{% set limit_reached = this.checkedCategoryCount >= constant('App\\Form\\Model\\LinkSubmission::MAX_CATEGORIES') %}
<fieldset data-test="{{ test_id }}">
    <legend class="mb-2 block text-sm font-medium text-gray-900 dark:text-gray-100">{{ field.vars.label }}</legend>

    <div class="mb-3 flex items-center gap-2">
        <input type="text" data-test="category-query" autocomplete="off" maxlength="60"
               value="{{ this.categoryQuery }}"
               data-model="debounce(200)|categoryQuery"
               data-action="keydown.enter->live#action:prevent" data-live-action-param="createCategory"
               placeholder="Filtrer ou créer une catégorie-besoin, puis Entrée"
               aria-label="Filtrer ou créer une catégorie"
               class="block w-full rounded-xl border border-gray-200 bg-white px-3 py-2 text-sm text-gray-900 placeholder:text-gray-400 focus:border-gray-900 focus:ring-gray-900 dark:border-gray-800 dark:bg-gray-950 dark:text-white dark:focus:border-white dark:focus:ring-white">
        <button type="button" data-test="category-create" title="Créer la catégorie"
                data-action="live#action" data-live-action-param="createCategory"
                class="grid size-9 shrink-0 place-items-center rounded-full bg-gray-900 text-white hover:bg-gray-700 focus:ring-4 focus:ring-gray-300 focus:outline-none dark:bg-white dark:text-gray-900 dark:hover:bg-gray-200 dark:focus:ring-gray-700">
            <twig:ux:icon name="tabler:plus" class="size-4"/>
            <span class="sr-only">Créer la catégorie</span>
        </button>
    </div>

    {% if this.categoryError %}
        <p class="mb-3 text-sm text-rose-700 dark:text-rose-400" data-test="category-error">{{ this.categoryError }}</p>
    {% endif %}
    {% if this.categoryNotice %}
        <p class="mb-3 text-sm text-amber-800 dark:text-amber-300" data-test="category-notice">{{ this.categoryNotice }}</p>
    {% endif %}

    {% if field|length > 0 %}
        <div class="flex flex-wrap gap-2">
            {% for choice in field %}
                {% set locked = limit_reached and not choice.vars.checked %}
                <label class="{{ locked ? 'cursor-not-allowed' : 'cursor-pointer' }}" {% if locked %}title="Trois catégories au plus"{% endif %}
                       {% if not this.isCategoryVisible(choice.vars.label) %}hidden{% endif %} data-test="category-pill">
                    {# Case brute, sans l'enveloppe du thème Flowbite : elle doit rester sœur de la pastille pour que `peer-checked` s'applique #}
                    <input type="checkbox" id="{{ choice.vars.id }}" name="{{ choice.vars.full_name }}" value="{{ choice.vars.value }}" class="peer sr-only"
                           {%- if choice.vars.checked %} checked{% endif %}{% if locked %} disabled{% endif %}>
                    {% do choice.setRendered %}
                    <span class="inline-flex items-center rounded-full bg-white px-3 py-1.5 text-sm text-gray-700 ring-1 ring-gray-200 transition hover:ring-gray-300 peer-checked:bg-gray-900 peer-checked:font-medium peer-checked:text-white peer-checked:ring-gray-900 peer-focus-visible:ring-2 peer-disabled:opacity-40 peer-disabled:hover:ring-gray-200 dark:bg-gray-950 dark:text-gray-300 dark:ring-gray-800 dark:peer-checked:bg-white dark:peer-checked:text-gray-900 dark:peer-checked:ring-white">
                        {{ choice.vars.label }}
                    </span>
                </label>
            {% endfor %}
        </div>
    {% else %}
        <p class="text-sm text-gray-500 dark:text-gray-400">Aucune catégorie pour l'instant : tapez la première, puis Entrée.</p>
    {% endif %}
    {{ form_errors(field) }}
</fieldset>
