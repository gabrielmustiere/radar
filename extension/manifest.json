{
  "manifest_version": 3,
  "name": "Radar",
  "description": "Ajoute la page en cours à Radar, la veille partagée de l'équipe, sans quitter l'onglet.",
  "version": "0.2.0",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Ajouter à Radar",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["activeTab", "contextMenus", "storage"],
  "host_permissions": ["https://radar.mustiere.fr/*", "https://radar.wip/*"],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
