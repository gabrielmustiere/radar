# APP_ENV=prod est fixé par l'image : ne pas le définir ici.

# Générer avec : openssl rand -hex 32
APP_SECRET=CHANGEME
# URL publique : sert aussi aux liens des annonces Chat générés par le worker (hors requête HTTP).
DEFAULT_URI=https://radar.mustiere.fr

DATABASE_URL="sqlite:///%kernel.project_dir%/var/data/radar.db"

# Table créée par les migrations : pas d'auto_setup.
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
# Radar n'envoie pas d'e-mail.
MAILER_DSN=null://null

# Webhook entrant de l'espace Google Chat (null://null = aucune annonce).
GOOGLE_CHAT_DSN=googlechat://ACCESS_KEY:ACCESS_TOKEN@default/SPACE
# Jeton GitHub en lecture seule, sans scope (vide = aperçu OpenGraph seulement).
GITHUB_TOKEN=
# Admin permanent des sources ; le compte se crée avec app:user:create.
RADAR_ADMIN_EMAIL=

# Caddy hôte -> docker-proxy -> conteneur : FrankenPHP voit l'IP de la gateway du réseau
# Compose (plage privée). Sans ça, X-Forwarded-Proto est ignoré : cookies non `secure`
# et redirection après connexion en http.
SYMFONY_TRUSTED_PROXIES=PRIVATE_SUBNETS
SYMFONY_TRUSTED_HEADERS=x-forwarded-for,x-forwarded-proto,x-forwarded-host
